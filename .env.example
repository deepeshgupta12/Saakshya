# Saakshya local environment — copy to .env and fill in. NEVER commit .env (see .gitignore).

# ── AI layer (Anthropic Claude — sole provider, D-057) ──────────────────
# Local project: you supply your own key (SPEC §14.4). Starts with sk-ant-...
ANTHROPIC_API_KEY=
SAAKSHYA_AI_PROVIDER=anthropic

# ── Zerodha Kite Connect (sole market-data source, D-058) ───────────────
# Create a "Connect" app at developers.kite.trade with redirect URL
# http://127.0.0.1:8000/kite/callback — it gives you API key + secret.
KITE_API_KEY=
KITE_API_SECRET=
# Daily access token — auto-populated by the login flow; leave blank to start.
KITE_ACCESS_TOKEN=
# Unattended TOTP login (D-058 option B): client id + password + external-TOTP secret.
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=
# Corporate-proxy CA: if your network TLS-inspects Kite (Sophos/Zscaler), point this at a
# PEM bundle that includes the proxy CA cert. Leave blank on a normal network.
KITE_CA_BUNDLE=

# ── Storage / data paths ────────────────────────────────────────────────
SAAKSHYA_DATA_DIR=data
SAAKSHYA_UNIVERSE_PATH=data/universe.csv

# ── EOD data source: kite (sole source) ─────────────────────────────────
SAAKSHYA_ACTIVE_DATA_SOURCE=kite
SAAKSHYA_HISTORY_PERIOD=max

# ── Databases (polyglot, D-059) — set once Phase 3 lands ────────────────
# TimescaleDB (time-series: OHLC, indicators, sector scores, corp actions)
# SAAKSHYA_TIMESCALE_URL=postgresql://saakshya:saakshya@localhost:5432/saakshya
# MongoDB (documents: users, portfolios, scanner_results, ai_summaries, ...)
# SAAKSHYA_MONGODB_URL=mongodb://localhost:27017/saakshya
