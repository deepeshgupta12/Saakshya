# Saakshya local environment — copy to .env and fill in. NEVER commit .env (see .gitignore).

# Anthropic API key for the AI explanation layer (used from milestone M4).
# Local project: you supply your own key (SPEC §14.4).
ANTHROPIC_API_KEY=

# Storage / data paths (defaults are fine for local-first).
SAAKSHYA_DUCKDB_PATH=data/saakshya.duckdb
SAAKSHYA_DATA_DIR=data
SAAKSHYA_UNIVERSE_PATH=data/universe.csv

# Active EOD data source: yfinance (prototype) | nse_bhavcopy (authoritative, M1 stub)
SAAKSHYA_ACTIVE_DATA_SOURCE=yfinance

# yfinance history window: "max" for full history, or e.g. "5y", "1y" for quick runs.
SAAKSHYA_HISTORY_PERIOD=max
